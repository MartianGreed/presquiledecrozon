{% extends 'create_rental/create-rental-layout.html.twig' %}

{% block create_rental_aside %}
    <div class="create__rental__aside__icon">
        {{ svg_icon('house', { h: 90 }) }}
    </div>
    <h2 class="create__rental__aside__title">Conditions</h2>
    <p>
        Nous tenons à ce que vous vous sentiez confiant à chaque réservation. C’est la raison pour laquelle nous demandons certaines informations à chaque personne avant qu’ils effectuent une réservation.
    </p>
{% endblock %}

{% block create_rental_main %}
