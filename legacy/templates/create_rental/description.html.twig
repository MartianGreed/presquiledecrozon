{% extends 'create_rental/create-rental-layout.html.twig' %}

{% block create_rental_aside %}
    <div class="create__rental__aside__icon">
        {{ svg_icon('house', { h: 90 }) }}
    </div>
    <h2 class="create__rental__aside__title">Détails de votre location</h2>
    <p>
        Ces informations de base nous aident à éveiller l'intérêt des vos futurs locataires de votre logement lors de leurs premières recherches.
    </p>
{% endblock %}

{% block create_rental_main %}
    <h1 class="create__rental__main__title">Etape 1: On se jette à l'eau</h1>
    <h2 class="create__rental__main__subtitle">Description du logement</h2>
    {% include 'create_rental/_forms/description.html.twig' with { form: form } %}
{% endblock %}