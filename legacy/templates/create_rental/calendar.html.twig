{% extends 'create_rental/create-rental-layout.html.twig' %}

{% block create_rental_aside %}
    <div class="create__rental__aside__icon">
        {{ svg_icon('calendar', { h: 90 }) }}
    </div>
    <h2 class="create__rental__aside__title">Mise à jour</h2>
    <p>
        Les jours grisés permettent aux futurs locataires de voir l'indisponibilité de votre location.
    </p>
{% endblock %}

{% block create_rental_main %}
    <h1 class="create__rental__main__title">Etape 2: Questions d'organisations</h1>
    <h2 class="create__rental__main__subtitle">Calendrier</h2>

    <p>Veuillez indiquer ici les indisponibilités de la location.</p>

    {% include 'create_rental/_forms/calendar.html.twig' with { form: form } %}
{% endblock %}