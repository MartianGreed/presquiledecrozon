{
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.2",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "async-aws/async-aws-bundle": "^1.7",
        "async-aws/core": "^1.13",
        "async-aws/dynamo-db": "^1.2",
        "async-aws/dynamo-db-session": "^1.0",
        "bref/bref": "^2.0",
        "bref/extra-php-extensions": "^1.0",
        "bref/symfony-bridge": "^1.0",
        "bref/symfony-messenger": "^1.0",
        "composer/package-versions-deprecated": "1.11.99.4",
        "doctrine/doctrine-bundle": "^2.15",
        "doctrine/doctrine-fixtures-bundle": "^4.0",
        "doctrine/doctrine-migrations-bundle": "^3.4",
        "doctrine/orm": "^2.20",
        "easycorp/easyadmin-bundle": "^4.24",
        "innmind/immutable": "^4.1",
        "intervention/image": "^3.0",
        "knplabs/knp-paginator-bundle": "^6.0",
        "league/flysystem": "^3.0",
        "league/flysystem-bundle": "^3.0",
        "phpdocumentor/reflection-docblock": "^5.3",
        "phpstan/phpdoc-parser": "^1.2",
        "stripe/stripe-php": "^17.0",
        "symfony/asset": "7.3.*",
        "symfony/asset-mapper": "7.3.*",
        "symfony/console": "7.3.*",
        "symfony/doctrine-messenger": "7.3.*",
        "symfony/dotenv": "7.3.*",
        "symfony/expression-language": "7.3.*",
        "symfony/flex": "^2",
        "symfony/form": "7.3.*",
        "symfony/framework-bundle": "7.3.*",
        "symfony/http-client": "7.3.*",
        "symfony/intl": "7.3.*",
        "symfony/mailer": "7.3.*",
        "symfony/mailjet-mailer": "7.3.*",
        "symfony/messenger": "7.3.*",
        "symfony/mime": "7.3.*",
        "symfony/monolog-bundle": "^3.0",
        "symfony/notifier": "7.3.*",
        "symfony/process": "7.3.*",
        "symfony/property-access": "7.3.*",
        "symfony/property-info": "7.3.*",
        "symfony/proxy-manager-bridge": "6.4.*",
        "symfony/runtime": "7.3.*",
        "symfony/security-bundle": "7.3.*",
        "symfony/serializer": "7.3.*",
        "symfony/string": "7.3.*",
        "symfony/translation": "7.3.*",
        "symfony/twig-bundle": "7.3.*",
        "symfony/ux-dropzone": "^2.26",
        "symfony/ux-lazy-image": "^2.26",
        "symfony/ux-turbo": "^2.26",
        "symfony/validator": "7.3.*",
        "symfony/web-link": "7.3.*",
        "symfony/webpack-encore-bundle": "^2.0",
        "symfony/yaml": "7.3.*",
        "twig/cssinliner-extra": "^3.4",
        "twig/extra-bundle": "^3.4",
        "twig/inky-extra": "^3.4",
        "twig/twig": "^3.21",
        "vich/uploader-bundle": "^2.0"
    },
    "config": {
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "symfony/flex": true,
            "symfony/runtime": true,
            "infection/extension-installer": true
        },
        "optimize-autoloader": true,
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "7.3.*"
        }
    },
    "require-dev": {
        "dbrekelmans/bdi": "^1.4",
        "fakerphp/faker": "^1.19",
        "friendsofphp/php-cs-fixer": "^3.84",
        "infection/infection": "^0.29",
        "league/flysystem-adapter-test-utilities": "^3.0",
        "phpspec/prophecy": "^1.22",
        "phpspec/prophecy-phpunit": "^2.4",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^12.0",
        "rector/rector": "^2.1",
        "symfony/browser-kit": "7.3.*",
        "symfony/css-selector": "7.3.*",
        "symfony/debug-bundle": "7.3.*",
        "symfony/maker-bundle": "^1.63",
        "symfony/panther": "^2.2",
        "symfony/phpunit-bridge": "^7.3",
        "symfony/stopwatch": "7.3.*",
        "symfony/web-profiler-bundle": "7.3.*",
        "symplify/easy-coding-standard": "^12.0"
    }
}
