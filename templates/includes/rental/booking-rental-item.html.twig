<div class="bookings_list__item">
    <div class="bookings_list__item__picture">
        <img
                srcset="
                            {{ uploaded_asset(booking.rental.gallery.cover, 'file', null, { h: 250, w: 250, crop: true}) }} 250w,
                            {{ uploaded_asset(booking.rental.gallery.cover, 'file', null, { h: 50, w: 50, crop: true}) }} 50w,
                       "
                src="{{ uploaded_asset(booking.rental.gallery.cover, 'file', null, { h: 250, w: 250, crop: true}) }}"
                alt="{{ booking.rental.configuration.type.label }} de {{ booking.rental.owner.profile.fullname }}"
        />
    </div>
    <div class="bookings_list__item__content">
        <div class="title">
            <div class="confirmed-at">
                <div class="date">
                    {% if booking.confirmedAt is not null %}
                        Réservation confirmée le {{ booking.confirmedAt | date('d/m/Y H:i:s') }}
                    {% else %}
                        Réservation en attente de confirmation
                    {% endif %}
                </div>
                <div class="period">
                    {{ booking.period }}
                </div>
            </div>
            <div class="owner-picture">
                {% set contact = app.user.id == booking.rental.owner.id ? booking.booker : booking.rental.owner %}
                <div class="name">
                    {{ contact.profile.fullname }}
                </div>
                <div class="picture">

                    {% if contact.profile.picture is not null %}
                        <img src="{{ uploaded_asset(contact.profile.picture, 'file', null, { h: 50, w: 50, crop: true}) }}" alt="Photo de profil {{ contact.profile.fullname }}">
                    {% endif %}
                </div>
            </div>
        </div>
        <div class="description">
            <div class="type">
                {{ booking.rental.configuration.type.label }}
            </div>
            <div class="title">
                {{ booking.rental.description.title }}
            </div>
        </div>
        <div class="details">
            <div class="people-count">
                {{ svg_icon('people') }} {{ booking.peopleCount }}
            </div>
            <div class="price">
                {{ booking.prices.totalPrice }}
            </div>
            <div class="see-details">
                <a href="#">Voir les détails de la réservation</a>
            </div>
        </div>
    </div>
</div>