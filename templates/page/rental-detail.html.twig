{% extends 'base.html.twig' %}

{% block page_title rental.description.title %}

{% block header %}
    {{ parent() }}
    <div class="hero">

    </div>
{% endblock %}

{% set content_class = 'rental_details' %}
{% block body %}
    <div class="rental_details__slideshow__container" data-controller="lightbox" data-lightbox-options-value='{"selector": "div.slideshow__item"}'>
        <div class="slideshow__cover slideshow__item" data-src="{{ cdn_host }}{{ uploaded_asset(rental.gallery.cover, 'file') }}">
            <img src="{{ uploaded_asset(rental.gallery.cover, 'file', null, { h: 1000, w: 1000, crop: true }) }}"
                 alt=""/>
        </div>
        {% for i in 0..3 %}
            <div class="slideshow__image slideshow__item" data-src="{{ cdn_host }}{{ uploaded_asset(rental.gallery.pictures[i], 'file', 'App\\Entity\\Media') }}">
                <img src="{{ uploaded_asset(rental.gallery.pictures[i], 'file', 'App\\Entity\\Media', { h: 400, w: 700, crop: true }) }}"
                     alt=""/>
            </div>
            {% if i == 1 %}
                <div class="slideshow__details">
                    <div class="item">
                        <div class="count">
                            {{ rental.configuration.peopleCount }}
                        </div>
                        <div class="text">
                            personnes
                        </div>
                    </div>
                    <div class="item">
                        <div class="count">
                            {{ rental.configuration.bedrooms.count }}
                        </div>
                        <div class="text">
                            chambres
                        </div>
                    </div>
                    <div class="item">
                        <div class="count">
                            {{ rental.configuration.bedCount }}
                        </div>
                        <div class="text">
                            lits
                        </div>
                    </div>
                </div>
            {% endif %}
        {% endfor %}
    </div>
    <div
            class="rental_details__content__container"
            data-controller="rental--detail"
            data-rental--detail-lat-value="{{ rental.geolocation.coordinates.lat }}"
            data-rental--detail-lng-value="{{ rental.geolocation.coordinates.lng }}"
    >
        <div class="rental_details__content__sidebar">
            <ul
                    class="sidebar__menu"
                    data-rental--detail-target="menu"
            >
                <li
                        class="sidebar__menu__item"
                        data-action="click->rental--detail#toggleContent"
                        data-toggle="rental_details_description"
                >
                    Description
                </li>
                <li
                        class="sidebar__menu__item"
                        data-action="click->rental--detail#toggleContent"
                        data-toggle="rental_details_map"
                >
                    Géolocalisation
                </li>
                <li
                        class="sidebar__menu__item"
                        data-action="click->rental--detail#toggleContent"
                        data-toggle="rental_details_availability"
                >
                    Disponibilité
                </li>
                <li
                        class="sidebar__menu__item"
                        data-action="click->rental--detail#toggleContent"
                        data-toggle="rental_details_conditions"
                >
                    Conditions/règlement
                </li>
            </ul>
        </div>
        <div
                class="rental_details__content__content"
                data-rental--detail-target="content"
        >
            <div id="rental_details_description" class="content_item">
                <h2 class="content__title">
                    Description
                </h2>
                <p class="mb-12">
                    {{ rental.description.description }}
                </p>

                <h3 class="content__subtitle">
                    Équipements
                </h3>
                <div class="content__furnitures__list">
                    {% for furniture in rental.furnitures %}
                        <div class="content__furnitures__item">
                            {{ furniture }}
                        </div>
                    {% endfor %}
                    {% for furniture in rental.customFurnitures %}
                        <div class="content__furnitures__item">
                            {{ furniture }}
                        </div>
                    {% endfor %}
                </div>
            </div>

            <div
                    id="rental_details_map"
                    class="content_item"
                    data-controller="rental--map"
                    data-rental--map-api-key-value="{{ gmaps_api_key }}"
                    data-rental--map-lat-value="{{ rental.geolocation.coordinates.lat }}"
                    data-rental--map-lng-value="{{ rental.geolocation.coordinates.lng }}"
            >
                <h2 class="content__title">
                    Géolocalisation
                </h2>
                <div>
                    {{ rental.address.address }}<br>
                    {% if rental.address.address2 is not null %}
                        {{ rental.address.address2 }}<br>
                    {% endif %}
                    {{ rental.address.town.postalCode.code }} - {{ rental.address.town }}
                </div>
                <div id="rental_details_map_display" data-rental--map-target="map"></div>
            </div>

            <div id="rental_details_availability" class="content_item">
                <h2 class="content__title">
                    Disponibilités
                </h2>
                <p>Toutes les dates n'étant pas marquées sont disponibles.</p>
                <div data-controller="calendar-read"
                     data-calendar-read-dates-value="{{ rental.displayUnavailabilities | merge(bookings) | json_encode }}">
                    <div data-calendar-read-target="container"></div>
                </div>
            </div>

            <div id="rental_details_conditions" class="content_item">
                <h2 class="content__title">
                    Conditions & Règlement
                </h2>
                <p>Veuillez bien prendre en compte les règles suivantes :</p>
                <ul>
                    <li>Logement {{ (rental.condition.smokingAllowed) ? '' : 'non' }} fumeur</li>
                    <li>Les animaux {{ (rental.condition.animalsAccepted) ? 'sont' : 'ne sont pas' }} acceptés</li>
                    {% for rule in rental.condition.additionnalRules %}
                        <li>{{ rule }}</li>
                    {% endfor %}
                </ul>
            </div>
        </div>
    </div>
    <div id="book_rental">
        {{ form_start(form, {
            attr: {
                'data-controller': 'form-types--booking-rental',
                'data-action': 'change->form-types--booking-rental#updateTotalPrice',
            }
        }) }}
        <div class="book_rental__avatar__container">
            <div class="book_rental__avatar">
                {% if rental.owner.profile.picture is not null %}
                    <img src="{{ uploaded_asset(rental.owner.profile.picture, 'file', null, { h: 150, w: 150, crop: true}) }}"
                         alt="Photo de profil {{ rental.owner.profile.fullname }}">
                {% endif %}
            </div>
        </div>
        <div class="book_rental__description">
            <div class="name">
                {{ rental.configuration.type.label }} de {{ rental.owner.profile.firstname }}
            </div>
            <div class="town">
                {{ rental.address.town.name }}
            </div>
        </div>
        <div class="book_rental__form">
            <div class="book_rental__form__errors">
                {{ form_errors(form.startAt) }}
                {{ form_errors(form.endAt) }}
                {{ form_errors(form.peopleCount) }}
            </div>
            <div class="book_rental__form__fields">
                <div class="form__row">
                    {{ form_widget(form.startAt, { label: false }) }}
                </div>
                <div class="form__row">
                    {{ form_widget(form.endAt, { label: false }) }}
                </div>
                <div class="form__row">
                    {{ form_widget(form.peopleCount, { label: false }) }}
                </div>
            </div>

        </div>
        <div
                class="book_rental__price"
                data-controller="booking--total-price"
                data-booking--total-price-api-value="{{ path('app_booking_price', { id: rental.id }) }}"
                data-form-types--booking-rental-target="price"
        >
            Veuillez sélectionner les dates pour connaître le montant de la location.
        </div>
        <div class="book_rental__contact">
            <a href="#">Contacter {{ rental.owner.profile.firstname }}</a>
        </div>
        <div class="book_rental__submit">
            <button type="submit" class="button button__blue">Réserver</button>
        </div>
        {{ form_end(form) }}
    </div>
{% endblock %}