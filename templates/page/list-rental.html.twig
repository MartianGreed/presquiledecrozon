{% extends 'base.html.twig' %}

{% block page_title 'Annonces' %}

{% block header %}
    {{ parent() }}
    <div class="hero">

    </div>
{% endblock %}

{% set content_class = 'rental_list' %}
{% block body %}
    <div class="app_container">
        <div class="rental_list__list">
            {% for rental in pagination %}
                {% include 'includes/rental/list-item.html.twig' with { rental: rental, height: 400, width: 500 } %}
            {% endfor %}
        </div>
        <div class="pagination">
            {{ knp_pagination_render(pagination) }}
        </div>
    </div>
{% endblock %}