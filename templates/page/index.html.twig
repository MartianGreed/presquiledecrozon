{% extends 'base.html.twig' %}

{% block page_title 'Accueil' %}

{% block header %}
    {{ parent() }}
    <div class="homepage__hero">
        <div class="homepage__hero__container">
            <div class="homepage__hero__title">
                <h1 class="title">Presqu'île de Crozon</h1>
                <div class="subtitleq">
                    Venez respirer l'air du large et vous ressourcer aux embruns bretons
                </div>
            </div>
            <div class="homepage__hero__cta">
                <a href="{{ path('app_rental_list') }}" class="button">Voir les locations</a>
            </div>
        </div>
    </div>
{% endblock %}

{% set content_class = 'homepage' %}
{% block body %}
    <div class="homepage__rental-list">
        <div class="app_container">
            <h1 class="homepage__rental-list__title">
                Se loger
                <small>
                    Trouvez votre logement saisonnier pour profiter pleinement de la presqu'île de Crozon
                </small>
            </h1>

            <div class="homepage__rental-list__content">
                {% for rental in rentals %}
                    {% include 'includes/rental/list-item.html.twig' with { rental: rental, height: 400, width: 500 } %}
                {% endfor %}
            </div>

            <div class="mt-12 text-center">
                <a href="{{ path('app_rental_list') }}" class="button button__blue">Voir les locations</a>
            </div>
        </div>
    </div>

    <div class="homepage__main_cta">
        <div class="app_container">
            <div class="homepage__main_cta__container">
                <div class="homepage__main_cta__item">
                    <h3>1. Je choisis</h3>
                    <p>la location qui me convient le mieux.</p>
                </div>
                <div class="homepage__main_cta__item">
                    <h3>2. Je réserve</h3>
                    <p>le logement qui correspond à mes critères de recherche.</p>
                </div>
                <div class="homepage__main_cta__item">
                    <h3>2. Je profite</h3>
                    <p>avec ma famille où entre amis, de la sérénité et de la richesse de la Presqu'île de Crozon.</p>
                </div>
            </div>

            <a href="{{ path('app_rental_list') }}" class="button button__blue">Voir les locations</a>
        </div>
    </div>

    <div class="homepage__second_cta">
        <div class="app_container">
            <div class="homepage__second_cta__container">
                <div class="homepage__second_cta__content">
                    <h3>Locations de particuliers à particuliers</h3>
                    <p>
                        Le site offre la possibilité aux particuliers de déposer leur annonce dans le but d'avoir un service autonome.
                    </p>
                    <strong>Vous possédez un bien que vous souhaitez louer ?</strong>
                    <a href="{{ path('app_create_rental') }}" class="button button__white">
                        Déposer mon annonce
                    </a>
                </div>
            </div>
        </div>
    </div>

    {% if subscription is not null %}
        <div class="homepage__subscription">
            <div class="app_container">
                <div class="homepage__subscription__container">
                    <h3>
                        {{ subscription.amount }}/an
                        <small>pour une location.</small>
                    </h3>
                    <a href="{{ path('app_create_rental') }}" class="button button__white">
                        Déposer mon annonce
                    </a>
                </div>
            </div>
        </div>
    {% endif %}
{% endblock %}
