{% extends 'emails/base.html.twig' %}

{% block email_content %}
    <row>
        <columns>
            <h2 class="text-left">Bonjour {{ profile.firstname }}</h2>
            <spacer size="16"></spacer>
            <p>
                Pour réinitialiser votre mot de passe, vous pouvez cliquer sur le lien ci-dessous, ou directement copier/coller l'url suivante dans votre navigateur.
            </p>
            <button href="{{ reset_password_url }}">Changer de mot de passe</button>
            <p>{{ reset_password_url }}</p>
        </columns>
    </row>
    <row>
        <columns>
            <spacer size="16"></spacer>
            <p>
                Si vous n'êtes pas à l'origine de cette demande, n'en tenez pas compte.
            </p>
        </columns>
    </row>
    <row>
        <columns large="6">
            <button href="{{ url('app_create_rental') }}">Déposer une annonce</button>
        </columns>
        <columns large="6">
            <button href="{{ url('app_rental_list') }}">Réserver un logement</button>
        </columns>
    </row>
{% endblock %}
