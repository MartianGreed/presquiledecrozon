{% extends 'create_rental/create-rental-layout.html.twig' %}

{% block create_rental_aside %}
    <div class="create__rental__aside__icon">
        {{ svg_icon('pictures', { h: 90 }) }}
    </div>
    <h2 class="create__rental__aside__title">Détails de votre location</h2>
    <p>
        Evitez le flash et les filtres ainsi que les photos floues. Faites attention qu'il y ait suffisamment de lumière sur celle-ci. Prioriser une pièce, un lieu avec un angle de vue correct si possible.
        <br><br>
        Veuillez télécharger au minimum 5 photos présentant vos lieux pour que vos locataires puissent se projeter plus facilement.
        <br><br>
        Contacter l’administrateur si vous souhaitez rajouter d’autres photos
    </p>
{% endblock %}

{% block create_rental_main %}
    <h1 class="create__rental__main__title">Etape 1: On se jette à l'eau</h1>
{#    <h2 class="create__rental__main__subtitle">Géolocalisation</h2>#}

    {{ form_start(form, { attr: {
        id: 'rental_pictures',
        'data-controller': 'form-types--pictures',
    } }) }}
        {{ form_row(form.cover, { label: 'Photo de couverture de votre logement'}) }}

        <label class="col-span-3">Photos supplémentaires</label>
        {{ form_row(form.pictures, {
            attr: {
                'data-form-types--pictures-target': 'container',
                'data-controller': 'form-types--collection',
                'data-form-types--collection-max-item-value': 5,
            }
        }) }}


        <div class="flex justify-end gap-4 mt-6 col-span-3">
            <button class="button button__outlined__grey">Retour</button>
            <button type="submit" class="button button__blue">Sauvegarder et continuer</button>
        </div>
    {{ form_end(form) }}
{% endblock %}