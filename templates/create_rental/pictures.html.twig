{% extends 'create_rental/create-rental-layout.html.twig' %}

{% block create_rental_aside %}
    <div class="create__rental__aside__icon">
        {{ svg_icon('pictures', { h: 90 }) }}
    </div>
    <h2 class="create__rental__aside__title">Détails de votre location</h2>
    <p>
        Evitez le flash et les filtres ainsi que les photos floues. Faites attention qu'il y ait suffisamment de lumière sur celle-ci. Prioriser une pièce, un lieu avec un angle de vue correct si possible.
        <br><br>
        Veuillez télécharger au minimum 5 photos présentant vos lieux pour que vos locataires puissent se projeter plus facilement.
        <br><br>
        Contacter l’administrateur si vous souhaitez rajouter d’autres photos
    </p>
{% endblock %}

{% block create_rental_main %}
    <h1 class="create__rental__main__title">Etape 1: On se jette à l'eau</h1>
    <div
            class="rental__uploader__form"
            data-controller="rental--upload-pictures-validator"
            data-action="rental--uploader:onUploadDone->rental--upload-pictures-validator#updateFormState"
    >
        {% if rental.gallery is not null and rental.gallery.cover is not null %}
            <div
                    data-controller="rental--uploader"
                    data-rental--uploader-upload-api-uri-value="{{ url('app_rental_upload_picture', { id: rental.id }) }}"
                    data-rental--uploader-field-value="cover"
                    class="mb-6"
            >
                <label for="" class="block text-gray-800 mb-3">Photo de couverture de votre logement</label>
                <div
                        data-rental--uploader-target="dropzoneContainer"
                        data-rental--upload-pictures-validator-target="image"
                >
                    <div class="dz-preview dz-processing dz-image-preview dz-success dz-complete">
                        <div class="dz-image">
                            <img data-dz-thumbnail=""
                                 alt=""
                                 src="{{ uploaded_asset(rental.gallery.cover, 'file', null, { w: 150, h: 150, crop: true}) }}"
                            ></div>
                        <div class="dz-details">
                            <div class="dz-size">
                                <span data-dz-size="">{{ rental.gallery.cover.size | human_filesize }}</span>
                            </div>
                            <div class="dz-filename"><span data-dz-name="">{{ rental.gallery.cover.name }}</span>
                            </div>
                        </div>
                        <a class="dz-remove" data-action="click->rental--uploader#removeImage">x</a>
                    </div>
                </div>
            </div>
        {% else %}
            <div
                    data-controller="rental--uploader"
                    data-rental--uploader-upload-api-uri-value="{{ url('app_rental_upload_picture', { id: rental.id }) }}"
                    data-rental--uploader-field-value="cover"
                    class="mb-6"
            >
                <label for="" class="block text-gray-800 mb-3">Photo de couverture de votre logement</label>
                <div
                        data-rental--uploader-target="dropzoneContainer"
                        data-rental--upload-pictures-validator-target="image"
                        class="no-file"
                ></div>
            </div>
        {% endif %}

        <label for="" class="block text-gray-800 mb-3">Photos supplémentaires</label>
        <div class="rental__uploader__picture">
            {% for i in 0..4 %}
                {% if rental.gallery is not null and rental.gallery.pictures[i] is defined %}
                    <div
                            data-controller="rental--uploader"
                            data-rental--uploader-upload-api-uri-value="{{ url('app_rental_upload_picture', { id: rental.id }) }}"
                            data-rental--uploader-field-value="picture"
                            data-rental--uploader-index-value="{{ i }}"
                    >
                        <div
                                data-rental--uploader-target="dropzoneContainer"
                                data-rental--upload-pictures-validator-target="image"
                        >
                            <div class="dz-preview dz-processing dz-image-preview dz-success dz-complete">
                                <div class="dz-image">
                                    <img data-dz-thumbnail=""
                                         alt=""
                                         src="{{ uploaded_asset(rental.gallery.pictures[i], 'file', null, { w: 150, h: 150, crop: true}) }}"
                                    ></div>
                                <div class="dz-details">
                                    <div class="dz-size">
                                        <span data-dz-size="">{{ rental.gallery.pictures[i].size | human_filesize }}</span>
                                    </div>
                                    <div class="dz-filename"><span data-dz-name="">{{ rental.gallery.pictures[i].name }}</span>
                                    </div>
                                </div>
                                <a class="dz-remove" data-action="click->rental--uploader#removeImage">x</a>
                            </div>
                        </div>
                    </div>
                {% else %}
                    <div
                            data-controller="rental--uploader"
                            data-rental--uploader-upload-api-uri-value="{{ url('app_rental_upload_picture', { id: rental.id }) }}"
                            data-rental--uploader-field-value="picture"
                            data-rental--uploader-index-value="{{ i }}"
                    >
                        <div
                                data-rental--uploader-target="dropzoneContainer"
                                data-rental--upload-pictures-validator-target="image"
                                class="no-file"
                        ></div>
                    </div>
                {% endif %}
            {% endfor %}
        </div>


        <div class="flex justify-end gap-4 mt-6 col-span-3">
            <button class="button button__outlined__grey">Retour</button>
            <a
                href="{{ next_step_url }}"
                class="button button__blue"
                data-rental--upload-pictures-validator-target="submitButton"
                data-controller="disable-click"
                data-action="click->disable-click#checkDisabled"
            >
                Sauvegarder et continuer
            </a>
        </div>
    </div>
{% endblock %}