{% extends 'create_rental/create-rental-layout.html.twig' %}

{% block create_rental_aside %}
    <div class="create__rental__aside__icon">
        {{ svg_icon('map-pin', { h: 90 }) }}
    </div>
    <h2 class="create__rental__aside__title">Détails de votre location</h2>
    <p>
        Nous protégeons vos coordonnées jusqu'à ce que vous obtenez une confirmation de réservation. Vos coordonnées ne sont transmises qu'une fois validation de votre part.
    </p>
{% endblock %}

{% block create_rental_main %}
    <h1 class="create__rental__main__title">Etape 1: On se jette à l'eau</h1>
    <h2 class="create__rental__main__subtitle">Géolocalisation</h2>
    <p>
        Validez-vous cette position de votre logement? Si oui, continuez.
        Si ce n'est pas le cas, vous pouvez déplacer le curseur pour indiquer la position exacte de votre logement.
    </p>

    {% if form is not null %}
        {% include 'create_rental/_forms/map.html.twig' with { form: form } %}
    {% else %}
        <div
                class="text-center my-12"
                data-controller="rental--fetch-geolocation"
                data-rental--fetch-geolocation-api-value="{{ fetch_geolocation_url }}"
        >
            <div class="w-2/4 my-0 mx-auto">
                <div>
                    Veuillez patienter le temps que nous récupérons les coordonées de votre logement...
                </div>
                <div class="flex justify-center mt-4">
                    <svg class="animate-spin -ml-1 mr-3 h-5 w-5 text-blue" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                    </svg>
                </div>
            </div>
        </div>
    {% endif %}
{% endblock %}