{{ form_start(form) }}
    {{ form_row(form.acceptedLastBooking, { label: 'Jusqu\'à quand prenez-vous les dernières réservations ?' }) }}
    {{ form_row(form.maxTimeBeforeBooking, { label: 'Combien de temps à l’avance les locataires peuvent-ils réserver ?' }) }}

    <label>Vos préférences</label>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 mt-3">
        <div>
            {{ form_row(form.beginBookingAt, { label: 'Heure d\'arrivée' }) }}
        </div>
        <div>
            {{ form_row(form.endBookingAt, { label: 'Heure de départ' }) }}
        </div>
    </div>



<div class="flex justify-end gap-4 mt-6" data-controller="back">
    <button type="button" class="button button__outlined__grey" data-action="back#back">Retour</button>
    <button type="submit" class="button button__blue">Sauvegarder et continuer</button>
</div>
{{ form_end(form) }}
