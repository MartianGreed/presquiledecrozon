{% extends 'create_rental/create-rental-layout.html.twig' %}

{% block create_rental_aside %}
    <div class="create__rental__aside__icon">
        {{ svg_icon('calendar', { h: 90 }) }}
    </div>
    <h2 class="create__rental__aside__title">Instructions</h2>
    <p>
        En autorisant les réservations le jour J, vous augmentez vos chances de louer votre logement pour les personnes reservant à la dernière minute.
    </p>
{% endblock %}

{% block create_rental_main %}
    <h1 class="create__rental__main__title">Etape 2: Questions d'organisations</h1>
    <h2 class="create__rental__main__subtitle">Disponibilités</h2>

    {% include 'create_rental/_forms/preferences.html.twig' with { form: form } %}
{% endblock %}