{% extends 'base.html.twig' %}

{% block title 'Créér mon compte' %}

{% block body %}
    <div class="container mx-auto mt-20">
        <div class="flex flex-col w-1/2 mx-auto shadow-lg rounded-lg px-4 py-6">
            <h1>Créer mon compte</h1>
            {{ form_start(form) }}
                {{ form_row(form.email, { label: 'Email'}) }}
                {{ form_row(form.password.first, { label: 'Mot de passe' }) }}
                {{ form_row(form.password.second, { label: 'Confirmation' }) }}
                <button class="button button__blue">Créér mon compte</button>
            {{ form_end(form) }}
        </div>
    </div>

{% endblock %}
