{% extends 'base.html.twig' %}

{% block title 'Créér mon compte' %}

{% block body %}
    <div class="app_container mt-20">
        <div class="flex flex-col w-full md:w-1/2 mx-auto shadow-none md:shadow-lg rounded-lg px-6 py-10 mb-12">
            <h1 class="main__title">Créer mon compte</h1>
            {{ form_start(form) }}
                {{ form_row(form.email, { label: 'Email'}) }}
                {{ form_row(form.password.first, { label: 'Mot de passe' }) }}
                {{ form_row(form.password.second, { label: 'Confirmation' }) }}
                <div class="text-center">
                    <button class="button button__blue">Je créér mon compte</button>
                </div>
            {{ form_end(form) }}
        </div>
    </div>

{% endblock %}
