{% extends 'base.html.twig' %}

{% block title 'Réinitialiser mon mot de passe' %}

{% block body %}
    <div class="app_container mt-20">
        <div class="app_container">
            <div class="flex flex-col w-full md:w-1/2 mx-auto shadow-none md:shadow-lg rounded-lg px-6 py-10 mb-12">
                <h1 class="main__title">Réinitialiser mon mot de passe</h1>
                {% if success_message %}
                    <p>
                        Votre demande de réinitialisation de mot de passe à bien été prise en compte.
                        Si un compte associé à l'email que vous avez fourni existe vous recevrez un mail contenant les instructions pour réinitialiser votre mot de passe !
                    </p>
                {% else %}
                    {{ form_start(form) }}
                        {{ form_row(form.email, { label: 'Email' }) }}
                        {{ form_row(form.submit, { label: 'Réinitialiser mon mot de passe', attr: { class: 'button button__blue' } }) }}
                    {{ form_end(form) }}
                {% endif %}
                <div class="flex flex-col mt-12">
                    <a href="{{ path('app_login') }}" class="text-blue hover:underline">Connexion</a>
                    <a href="{{ path('app_register') }}" class="text-blue hover:underline">Je n'ai pas de compte</a>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
