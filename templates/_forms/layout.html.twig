{% use 'tailwind_2_layout.html.twig' %}

{%- block counter_row -%}
    {%- set row_attr = row_attr|merge({
        'class': 'counter__type__input',
        'data-controller': 'form-types--counter',
    }) -%}
    {{- block('form_row') -}}
{%- endblock -%}

{%- block counter_widget -%}
    {%- set widget_attr = { attr: { class: 'counter__type__input__item', 'data-form-types--counter-target': 'input' }} -%}
    <div class="counter__type__widget__container">
        <button
                type="button"
                aria-hidden="true"
                class="counter__type__widget__action"
                data-action="click->form-types--counter#decrease"
        >-</button>
        {{- form_widget(form, widget_attr) -}}
        <button
                type="button"
                aria-hidden="true"
                class="counter__type__widget__action"
                data-action="click->form-types--counter#increase"
        >+</button>
    </div>
{%- endblock -%}

{%- block bedroom_row -%}
    {%- set row_attr = row_attr|merge({
        'class': 'bedroom__type__input',
        'data-controller': 'form-types--bedroom',
        'data-action': 'form-types--counter:changeCount->form-types--bedroom#changeBedCount'
    }) -%}
    {{- block('form_row') -}}
{%- endblock -%}

{%- block bedroom_label -%}
    <div class="bedroom__type__label__wrapper">
        <div class="bedroom__type__label__container">
            {{- block('form_label') -}}
            <button
                    class="button button__blue"
                    data-form-types--bedroom-target="fieldToggler"
                    data-action="click->form-types--bedroom#toggleFields"
            >
                Définir le nombre de lits
            </button>
        </div>
        <div>
            <span class="bedroom__type__input__bed-counter" data-form-types--bedroom-target="bedCounter">0 lit</span>
        </div>
    </div>
{%- endblock -%}

{%- block bedroom_widget -%}
    <div class="hidden bedroom__type__fields" data-form-types--bedroom-target="fieldContainer">
        {{- form_widget(form) -}}
    </div>
{%- endblock -%}


{%- block custom_furnitures_row -%}
    {% set prototype = form_row(form.vars.prototype) %}
    {%- set row_attr = row_attr|merge({
        'class': 'custom_furnitures__type__input',
        'data-controller': 'form-types--custom-furnitures',
        'data-prototype': prototype,
    }) -%}

    {{- block('form_row') -}}
{%- endblock -%}

{%- block custom_furnitures_widget -%}
    {{- form_widget(form, { attr: { 'data-form-types--custom-furnitures-target': 'fieldContainer' } }) -}}
    <div id="custom-furnitures-input">
        <input type="text" data-form-types--custom-furnitures-target="input" placeholder="Équipement supplémentaire" />
        <button type="button" class="button button__blue" data-action="form-types--custom-furnitures#addItem">Ajouter</button>
    </div>
{%- endblock -%}

{%- block _rental_furnitures_customFurnitures_entry_row -%}
    <div class="custom_furnitures__type__entry">
        <button type="button" data-action="form-types--custom-furnitures#removeItem">x</button>
        {{- block('form_widget') -}}
    </div>
{%- endblock -%}

{%- block collection_form_widget -%}
    <div {{ block('widget_container_attributes') }}>
        <div class="buttons">
            <button type="button" data-action="form-types--collection#addPrototype"><i class="fas fa-plus"></i> Ajouter</button>
        </div>
        {%- if form is rootform -%}
            {{ form_errors(form) }}
        {%- endif -%}
        {{- block('form_rows') -}}
        {{- form_rest(form) -}}
    </div>
{%- endblock collection_form_widget -%}

{%- block money_widget -%}
    {%- set prepend = not (money_pattern starts with '{{') -%}
    {%- set append = not (money_pattern ends with '}}') -%}
    {% set input_group_text_class = 'input-group-text' ~ (append ? ' appended' : '') ~ (prepend ? ' prepended' : '') %}
    {%- if prepend or append -%}
        <div class="input-group{{ group_class|default('') }}">
            {%- if prepend -%}
                <span class="{{ input_group_text_class }}">{{ money_pattern|form_encode_currency }}</span>
            {%- endif -%}
            {{- block('form_widget_simple') -}}
            {%- if append -%}
                <span class="{{ input_group_text_class }}">{{ money_pattern|form_encode_currency }}</span>
            {%- endif -%}
        </div>
    {%- else -%}
        {{- block('form_widget_simple') -}}
    {%- endif -%}
{%- endblock -%}

{%- block collection_widget -%}
    {% if prototype is defined and not prototype.rendered %}
        {%- set attr = attr|merge({'data-prototype': form_row(prototype) }) -%}
    {% endif %}
    {{- block('collection_form_widget') -}}
{%- endblock collection_widget -%}

{%- block form_row -%}
    {% set default_classes = 'mb-6 form__row' ~ ' ' ~ cache_key|str_replace(id, '')  %}

    {% if false == valid %}{% set default_classes = default_classes ~ ' has_error' %}{% endif %}
    {% set row_class = row_attr.class|default('') %}
    {%- set row_attr = row_attr|merge({
        class: row_class ~ ' ' ~ default_classes
    }) -%}
    {{- parent() -}}
{%- endblock form_row -%}

{%- block checkbox_row -%}
    {%- set row_attr = row_attr|merge({ class: row_attr.class|default(row_class|default('mb-6')) }) -%}
    {%- set widget_attr = {} -%}
    {%- if help is not empty -%}
        {%- set widget_attr = {attr: {'aria-describedby': id ~"_help"}} -%}
    {%- endif -%}
    <div{% with {attr: row_attr} %}{{ block('attributes') }}{% endwith %}>
        {{- form_errors(form) -}}
        <div class="flex inline-flex items-center">
            {{- form_widget(form, widget_attr) -}}
            {{- form_label(form) -}}
        </div>
        {{- form_help(form) -}}
    </div>
{%- endblock checkbox_row -%}

{%- block choice_widget_collapsed -%}
    {%- if icon is defined and icon is not null -%}
        {%- set prepend = true -%}
        {%- set append = false -%}
        {% set input_group_text_class = 'input-group-text' ~ (append ? ' appended' : '') ~ (prepend ? ' prepended' : '') %}
        {%- if prepend or append -%}
            <div class="input-group{{ group_class|default('') }}">
                {%- if prepend -%}
                    <span class="{{ input_group_text_class }}">
                        {% if not(svg) %}
                            {{ icon|raw }}
                        {% else %}
                            {{ svg_icon(icon) }}
                        {% endif %}
                    </span>
                {%- endif -%}
                    {{- parent() -}}
                {%- if append -%}
                    <span class="{{ input_group_text_class }}">
                        {% if not(svg) %}
                            {{ icon|raw }}
                        {% else %}
                            {{ svg_icon(icon) }}
                        {% endif %}
                    </span>
                {%- endif -%}
            </div>
        {%- endif -%}
    {%- else -%}
        {{- parent() -}}
    {%- endif -%}
{%- endblock -%}

