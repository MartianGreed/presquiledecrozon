{% extends 'base.html.twig' %}

{% block body %}
    <div class="profile__container">
        <div class="profile__sidebar">
            <div class="profile__sidebar__inner">
                <div class="profile__sidebar__inner__header">
                    {% if app.user.profile is not null and app.user.profile.picture is not null %}
                        <div class="profile__sidebar__inner__header__picture">
                            <img src="{{ uploaded_asset(app.user.profile.picture, 'file', null, { h: 200, w: 200 }) }}" alt="">
                        </div>
                    {% endif %}
                    {% if app.user.profile is not null and app.user.profile.firstname is not null and app.user.profile.lastname is not null %}
                    <div class="profile__sidebar__inner__header__name">{{ app.user.profile.firstname }} {{ app.user.profile.lastname }}</div>
                    {% endif %}
                    <div class="profile__sidebar__inner__header__since">Membre depuis {{ app.user.createdAt | date('Y') }}</div>
                </div>
                <ul class="profile__sidebar__inner__menu">
                    <li class="profile__sidebar__inner__menu-item">
                        <a href="{{ path('app_profile_conversation') }}">Messagerie</a>
                    </li>
                    <li class="profile__sidebar__inner__menu-item">
                        <a href="{{ path('app_profile_booking') }}">Réservations</a>
                    </li>
                    <li class="profile__sidebar__inner__menu-item">
                        <a href="{{ path('app_profile_booker_bookings_list') }}">Vacances</a>
                    </li>
                    <li class="profile__sidebar__inner__menu-item">
                        <a href="{{ path('app_profile_rental') }}">Annonces</a>
                    </li>
                    <li class="profile__sidebar__inner__menu-item">
                        <a href="{{ path('app_profile_informations') }}">Informations</a>
                    </li>
                    <li class="profile__sidebar__inner__menu-item">
                        <a href="{{ path('app_logout') }}">Déconnexion</a>
                    </li>
                </ul>
            </div>
        </div>
        <div class="profile__main">
            {% block profile_main '' %}
        </div>
    </div>
{% endblock %}