{% extends 'profile/profile_layout.html.twig' %}

{% block title %}Locations{% endblock %}
{% block page_title 'Liste des locations' %}
{% set content_class = 'profile_rental_list' %}

{% block profile_main %}
    <div class="rental__container">
        <h1 class="main__title">Annonces</h1>
        
        <div class="flex justify-end">
            <a class="button button__blue" href="{{ url('app_create_rental') }}"><i class="fas fa-plus"></i> Ajouter une location</a>
        </div>

        <div class="rental__list">
            {% for rental in rentals %}
                <div class="rental__list__item {{ rental.status.value }}">
                    <div class="rental__list__item__inner">
                        <div class="rental__list__item__inner__picture">
                            <img src="{{ uploaded_asset(rental.gallery.cover, 'file', null, { h: 150, w: 150, crop: true }) }}" alt="">
                        </div>
                        <div class="rental__list__item__inner__content">
                            <div class="title">{{ rental.description.title }}</div>
                            <div class="type">{{ rental.configuration.type.label }}</div>
                        </div>
                        <div class="rental__list__item__inner__actions">
                            <div><a href="{{ url('app_create_rental', { token: generate_token(rental.id), id: rental.id }) }}"><i class="far fa-edit"></i></a></div>
                            <label
                                    data-controller="toggle-publish-rental"
                                    data-toggle-publish-rental-api-uri-value="{{ url('app_rental_toggle_publish', { id: rental.id }) }}"
                                    for="toggle-publish-rental-{{ rental.id }}"
                            >
                                <input
                                        id="toggle-publish-rental-{{ rental.id }}"
                                        type="checkbox"
                                        data-action="change->toggle-publish-rental#togglePublishRental"
                                        data-toggle-publish-rental-target="input"
                                        {% if rental.published %}checked{% endif %}
                                /> Publier l'annonce
                            </label>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}
