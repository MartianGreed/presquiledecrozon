{
  "name": "presquiledecrozon",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "bun --watch apps/api/src/main.ts",
    "start": "bun apps/api/src/main.ts",
    "db:migrate": "bun apps/api/src/migrate.ts",
    "typecheck": "tsc --noEmit && node node_modules/@angular/compiler-cli/bundles/src/bin/ngc.js -p apps/web/tsconfig.app.json --noEmit",
    "lint": "biome check apps/api packages scripts apps/web/src apps/web/e2e playwright.migration.config.ts --error-on-warnings",
    "lint:fix": "biome check --write apps/api packages scripts apps/web/src apps/web/e2e playwright.migration.config.ts",
    "test": "bun scripts/test.ts",
    "build": "node node_modules/@angular/cli/bin/ng.js build",
    "test:e2e": "node node_modules/@playwright/test/cli.js test -c playwright.migration.config.ts",
    "check": "bun run lint && bun run typecheck && bun run test && bun run build",
    "test:unit": "bun test apps/api/test/pricing.test.ts",
    "legacy:export": "bun scripts/legacy-data.ts export",
    "legacy:import": "bun scripts/legacy-data.ts import",
    "admin:promote": "bun scripts/promote-admin.ts"
  },
  "dependencies": {
    "@angular/common": "22.1.6",
    "@angular/compiler": "22.1.6",
    "@angular/core": "22.1.6",
    "@angular/forms": "22.1.6",
    "@angular/platform-browser": "22.1.6",
    "@angular/router": "22.1.6",
    "@effect/platform": "0.97.2",
    "@effect/platform-bun": "0.91.2",
    "@structure-ai/auth": "0.1.1",
    "@structure-ai/auth-pg": "0.1.1",
    "@structure-ai/config": "0.1.1",
    "@structure-ai/http": "0.1.1",
    "@structure-ai/runtime": "0.1.1",
    "effect": "3.22.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.4",
    "stripe": "22.6.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.1.8",
    "@angular/cli": "22.1.8",
    "@angular/compiler-cli": "22.1.6",
    "@types/bun": "1.3.14",
    "typescript": "~6.0.3",
    "@biomejs/biome": "2.5.11",
    "@playwright/test": "1.62.1"
  },
  "engines": {
    "bun": ">=1.3.14",
    "node": "^24.15.0"
  },
  "overrides": {
    "@opentelemetry/core": "2.11.0"
  }
}
