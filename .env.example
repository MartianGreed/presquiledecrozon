# Copy to .env.local. Use a dedicated local database.
DATABASE_URL=postgres://crozon:crozon@localhost:5432/crozon
APP_ORIGIN=http://localhost:3000
PORT=3000
UPLOAD_DIRECTORY=./var/uploads
WEB_DIRECTORY=./dist/web/browser
# outbox stores mail for local inspection; mailjet delivers it.
MAIL_MODE=outbox
EMAIL_SENDER=bonjour@presquiledecrozon.fr
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
GOOGLE_MAPS_API_KEY=

# Optional social sign-in. Each provider is hidden until both values are set.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
FACEBOOK_OAUTH_CLIENT_ID=
FACEBOOK_OAUTH_CLIENT_SECRET=
FACEBOOK_GRAPH_VERSION=v25.0
# Passkeys use APP_ORIGIN as their origin and relying-party hostname.
